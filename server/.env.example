# ─────────────────────────────────────────────────────────────
# JobTrack — backend environment variables
# Copy this file to server/.env and fill in your own values:
#     cp .env.example .env
# .env is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
#   Local MongoDB:  mongodb://localhost:27017/job-applicant-tracker
#   Local (127.0.0.1 avoids IPv6 resolution issues on some machines)
#                   mongodb://127.0.0.1:27017/job-applicant-tracker
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-applicant-tracker
MONGO_URI=mongodb://127.0.0.1:27017/job-applicant-tracker

# JWT — use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional: browser origins allowed to call the API directly (comma separated).
# Only needed if you call the API from a browsed origin other than localhost:3000.
# CLIENT_ORIGIN=http://localhost:3000
